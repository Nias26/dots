#!/usr/bin/env python3

import os
import socket
import subprocess
import time

runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
socket2_path = f"{runtime_dir}/hypr/{signature}/.socket2.sock"
socket_path = f"{runtime_dir}/hypr/{signature}/.socket.sock"

last_notified = {}
COOLDOWN = 2.0


def get_window_details(addr):
    try:
        out = subprocess.check_output(
            ["hyprctl", "clients", f"address:{addr}"], text=True
        )
        w_class, w_title = "Unknown", "Window Urgent"

        for line in out.splitlines():
            line = line.strip()
            if line.startswith("class:"):
                w_class = line.split("class:")[1].strip()
            elif line.startswith("title:"):
                w_title = line.split("title:")[1].strip()

        return w_class, w_title
    except Exception:
        return "Unknown", "Window Urgent"


def notify(addr):
    current_time = time.time()
    if addr in last_notified and (current_time - last_notified[addr]) < COOLDOWN:
        return

    last_notified[addr] = current_time

    w_class, w_title = get_window_details(addr)

    subprocess.run(
        [
            "notify-send",
            "-t",
            "2000",
            "-u",
            "critical",
            "-a",
            "Hyprland",
            f"🚨 Urgent: {w_class}",
            w_title,
        ],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )


def main():
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.connect(socket2_path)

    with client.makefile("r", encoding="utf-8") as stream:
        for line in stream:
            line = line.strip()
            if not line:
                continue

            if line.startswith("urgent>>"):
                addr = "0x" + line.split(">>")[1]
                notify(addr)
            elif line.startswith("closewindow>>"):
                addr = "0x" + line.split(">>")[1]
                last_notified.pop(addr, None)


if __name__ == "__main__":
    main()
