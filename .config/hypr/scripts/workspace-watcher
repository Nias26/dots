#!/usr/bin/env python3

# NOTE: Vibe coded

import socket
import os
import subprocess
import json
import time

# Setup paths
runtime_dir = os.environ.get("XDG_RUNTIME_DIR")
signature = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
socket_path = f"{runtime_dir}/hypr/{signature}/.socket2.sock"

# Tracking notification timestamps { "address": float_timestamp }
last_notified = {}
# Seconds to wait before allowing another notification for the same window
COOLDOWN = 2.0


def notify(addr):
    current_time = time.time()

    # Check if we've notified for this specific window address recently
    if addr in last_notified:
        if current_time - last_notified[addr] < COOLDOWN:
            return  # This is a duplicate signal, ignore it

    try:
        # Get window info only when we know we need to notify
        out = subprocess.check_output(["hyprctl", "clients", "-j"])
        clients = json.loads(out)
    except Exception:
        return

    for c in clients:
        if c["address"] == addr:
            # Update the timestamp immediately before notifying
            last_notified[addr] = current_time

            subprocess.run(
                [
                    "notify-send",
                    "-t",
                    "2000",
                    "-u",
                    "critical",
                    "-a",
                    "Hyprland",
                    f"🚨 Urgent: {c['class']}",
                    c[f"title"],
                ]
            )
            break


# Connect to Hyprland socket
client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
client.connect(socket_path)

while True:
    data = client.recv(1024).decode("utf-8")
    if not data:
        break

    for line in data.splitlines():
        # Event format: urgent>>[address]
        if line.startswith("urgent>>"):
            addr = "0x" + line.split(">>")[1]
            notify(addr)

        # Cleanup tracking when a window is closed
        elif line.startswith("closewindow>>"):
            addr = "0x" + line.split(">>")[1]
            last_notified.pop(addr, None)
