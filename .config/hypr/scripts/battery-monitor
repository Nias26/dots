#!/bin/bash

LOW=20
BAT="/sys/class/power_supply/BAT0"
LAST=""

apply_mode() {
  read -r CAPACITY < "$BAT/capacity"
  read -r STATUS < "$BAT/status"

    if [[ "$STATUS" == "Charging" || "$STATUS" == "Full" ]]; then
      MODE="performance"
    elif [[ $CAPACITY < $LOW ]]; then
      MODE="power-saver"
    else
      MODE="balanced"
    fi

  if [[ "$MODE" != "$LAST" ]]; then
    tlpctl "$MODE" 2>/dev/null || tlpctl balanced
    notify-send -r 9991 \
      "Activating Power Mode: $MODE" \
      "Battery: ${CAPACITY}% (${STATUS})"

    LAST="$MODE"
  fi
}

apply_mode

udevadm monitor --udev --subsystem-match=power_supply |
  while read -r line; do
    [[ "$line" == *change* ]] && apply_mode
  done
