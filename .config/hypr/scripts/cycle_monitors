#!/usr/bin/env bash

ALL_MONITORS=$(hyprctl monitors all -j)
ACTIVE_MONITORS=$(hyprctl monitors -j)

EXTERNAL_NAME=$(echo "$ALL_MONITORS" | jq -r '.[] | select(.name != "eDP-1") | .name' | head -n 1)

if [ -z "$EXTERNAL_NAME" ] || [ "$EXTERNAL_NAME" = "null" ]; then
    notify-send "Display Switcher" "No external display detected."
    exit 0
fi

IS_ACTIVE=$(echo "$ACTIVE_MONITORS" | jq -r ".[] | select(.name == \"$EXTERNAL_NAME\") | .name")
MIRROR_OF=$(echo "$ACTIVE_MONITORS" | jq -r ".[] | select(.name == \"$EXTERNAL_NAME\") | .mirrorOf")

if [ -z "$IS_ACTIVE" ] || [ "$IS_ACTIVE" = "null" ]; then
    # CURRENT: Internal Only -> NEXT: Extended
    hyprctl eval "hl.monitor({ output = 'eDP-1', mode = 'highres@highrr', position = 'auto', scale = 'auto' }); hl.monitor({ output = '$EXTERNAL_NAME', disabled = false, mode = 'highres@highrr', position = '0x0', scale = 'auto' })"
    notify-send "Display Profile" "Switched to Extended Layout"

elif [ -n "$MIRROR_OF" ] && [ "$MIRROR_OF" != "null" ] && [ "$MIRROR_OF" != "" ]; then
    # CURRENT: Mirroring -> NEXT: Internal Only
    hyprctl eval "hl.monitor({ output = 'eDP-1', mode = 'highres@highrr', position = 'auto', scale = 'auto' }); hl.monitor({ output = '$EXTERNAL_NAME', disabled = true })"
    notify-send "Display Profile" "Switched to Internal Only"

else
    # CURRENT: Extended -> NEXT: Mirror
    hyprctl eval "hl.monitor({ output = 'eDP-1', mode = 'highres@highrr', position = 'auto', scale = 'auto' }); hl.monitor({ output = '$EXTERNAL_NAME', disabled = false, mode = 'preferred', position = 'auto', scale = 'auto', mirror = 'eDP-1' })"
    notify-send "Display Profile" "Switched to Mirror Layout"
fi
