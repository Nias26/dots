#!/usr/bin/env python3

# TODO: 2026-08-19 18:51 - Nias: Rewrite in C

import os
import sys
import time
import random
import signal
import subprocess
from pathlib import Path

WALLPAPER_DIR = Path("~/Immagini/Wallpapers").expanduser()
INTERVAL = 300
SYMLINK_PATH = Path("/tmp/current_wallpaper")

current_wallpaper = None
paused = False
skip_timer = False
state_changed = False


def get_all_images(directory):
    valid_extensions = {".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp"}
    images = []

    # rglob traverses directories and resolves symlinks automatically
    for p in Path(directory).rglob("*"):
        resolved_path = p.resolve() if p.is_symlink() else p
        if resolved_path.is_file() and resolved_path.suffix.lower() in valid_extensions:
            images.append(p)
    return images


def set_wallpaper(path):
    global current_wallpaper
    if not path or not path.exists():
        return

    # 1. Update awww backend
    subprocess.run(
        ["awww", "img", "-a", "-t", "random", str(path)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
    )

    try:
        if SYMLINK_PATH.exists() or SYMLINK_PATH.is_symlink():
            SYMLINK_PATH.unlink()
        SYMLINK_PATH.symlink_to(path)
    except Exception as _:
        pass

    current_wallpaper = path


def load_next():
    global skip_timer
    images = get_all_images(WALLPAPER_DIR)
    if images:
        # Avoid picking the exact same wallpaper back-to-back if possible
        choice = random.choice(images)
        if choice == current_wallpaper and len(images) > 1:
            images.remove(choice)
            choice = random.choice(images)
        set_wallpaper(choice)
    skip_timer = True


def handle_signal(signum, _):
    global paused, skip_timer, state_changed, WALLPAPER_DIR, INTERVAL

    if signum == signal.SIGUSR1:  # Next / Force Load
        load_next()
    elif signum == signal.SIGUSR2:  # Toggle Pause / Resume
        paused = not paused
    elif signum == signal.SIGHUP:  # Reset / Reload State Config
        config_file = Path("/tmp/awww_manager_ipc")
        if config_file.exists():
            try:
                lines = config_file.read_text().strip().split("\n")
                for line in lines:
                    if line.startswith("DIR:"):
                        WALLPAPER_DIR = Path(line.split(":", 1)[1]).expanduser()
                    elif line.startswith("INT:"):
                        INTERVAL = int(line.split(":", 1)[1])
                    elif line.startswith("IMG:"):
                        path = Path(line.split(":", 1)[1]).expanduser()
                        path = path.resolve() if path.is_symlink() else path
                        set_wallpaper(path)
            except:
                pass
        skip_timer = True


def main():
    global skip_timer

    signal.signal(signal.SIGUSR1, handle_signal)
    signal.signal(signal.SIGUSR2, handle_signal)
    signal.signal(signal.SIGHUP, handle_signal)

    load_next()

    while True:
        time_elapsed = 0
        skip_timer = False

        while time_elapsed < INTERVAL:
            if skip_timer:
                break
            if not paused:
                time_elapsed += 1
            time.sleep(1)

        if not skip_timer and not paused:
            load_next()


if __name__ == "__main__":
    # Ensure background process writes PID for client control
    Path("/tmp/awww_manager.pid").write_text(str(os.getpid()))
    main()
