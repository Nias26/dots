{
  "theme": {
    "enableTerm": false,
    "enableDiscord": false,
    "enableBtop": false,
    "enableGtk": true,
    "enableQt": true
  },
  "toggles": {
    "communication": {
      "discord": {
        "enable": true,
        "match": [{ "class": "discord" }],
        "command": ["discord"],
        "move": true
      },
      "whatsapp": {
        "enable": true,
        "match": [{ "class": "whatsapp" }],
        "move": true
      }
    },
    "music": {
      "ytmusic": {
        "enable": true,
        "match": [{ "class": "com.github.th_ch.youtube_music" }, { "initialTitle": "YouTube Music" }],
        "move": true
      }
    }
  }
}
