           if [ "$DEBUG" -eq 1 ]; then echo "Map saved: $DEV_PATH -> $LINK"; fi
         fi
       fi
@@ -63,7 +63,7 @@
   device_unmounted|device_ejected|device_removed)
     FOUND_LINK=""
