     fi
     if [ -z "$FOUND_LINK" ]; then
       FOUND_LINK="$LINK"
@@ -83,7 +83,7 @@
       if [ "$DEBUG" -eq 1 ]; then echo "No symlink to remove at $FOUND_LINK"; fi
     fi
     if [ -n "$DEV_PATH" ] && [ -f "$MAP_FILE" ]; then
