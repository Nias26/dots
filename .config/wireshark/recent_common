# Common recent settings file for Wireshark 4.7.4.
#
# This file is regenerated each time Wireshark is quit
# and when changing configuration profile.
# So be careful, if you want to make manual changes here.

######## Recent capture files (latest last), cannot be altered through command line ########


######## Recent capture filters (latest first), cannot be altered through command line ########


######## Recent display filters (latest last), cannot be altered through command line ########

recent.display_filter: tcp.stream eq 1
recent.display_filter: tcp.connection.syn
recent.display_filter: _ws.col.protocol == "TCP"
recent.display_filter: arp
recent.display_filter: dns
recent.display_filter: eth.type == 0x0806
recent.display_filter: http
recent.display_filter: tcp
recent.display_filter: tcp.connection.rst
recent.display_filter: tcp.checksum.status == 1

######## Recent remote hosts (latest first), cannot be altered through command line ########


