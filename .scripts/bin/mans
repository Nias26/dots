#!/bin/sh

#
# mans - friendly interface for man
#

vers=3.1
desc=0
SECTION=""
fzf_height=75
fzf_preview_lines=200
fzf_desc_width=80

version() {
    echo "mans : friendly interface for man"
    echo "version : $vers"
}

quickhelp() {
    version
    echo
    cat << EOF
USAGE:
   mans [-d|--desc] [-s SECTION|--section SECTION]

OPTIONS:
   -d, --desc          Use description mode (search by description)
   -s, --section       Limit search to a specific man section (1-9)
   -h, --help          Show this help
   -v, --vers          Show version
EOF
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        -d|--desc) desc=1; shift ;;
        -s|--section) shift; SECTION="$1"; shift ;;
        -h|--help) quickhelp; exit ;;
        -v|--vers) version; exit ;;
        *) man "$@"; exit ;;
    esac
done

section_opt=""
[ -n "$SECTION" ] && section_opt="-s $SECTION"

if [ "$desc" -eq 1 ]; then
    # description mode: section + command + truncated description
    list="$list$(apropos $section_opt . \
        | awk -v w="$fzf_desc_width" '{
            sec=$2; gsub(/[()]/,"",sec);
            desc=substr($0,index($0,$3),w);
            printf "\033[1;34m(%s)\033[0m %-20s %s\n", sec, $1, desc
        }' | sort -u)"
    fzf_prompt="Description: "
else
    # command mode: section + command only
    list="$list$(apropos $section_opt . \
        | awk '{
            sec=$2; gsub(/[()]/,"",sec);
            printf "\033[1;34m(%s)\033[0m %s\n", sec, $1
        }' | sort -u)"
    fzf_prompt="Command: "
fi

manual_line=$(printf "%b\n" "$list" | fzf \
    --height="${fzf_height}%" \
    --reverse --ansi --prompt="$fzf_prompt" \
    --preview="
        line={};
        clean_line=\$(echo \"\$line\" | sed 's/\\x1b\\[[0-9;]*m//g');
        cmd=\$(echo \"\$clean_line\" | awk '{print \$2}');
        sec=\$(echo \"\$clean_line\" | awk '{gsub(/[()]/,\"\",\$1); print \$1}');
        # auto-section for headers
        case \"\$cmd\" in
            *.h) sec=7 ;;
        esac
        if [ $desc -eq 1 ]; then
            apropos $section_opt \"\$cmd\"
        else
            if command -v bat >/dev/null 2>&1; then
                if [ -n \"$SECTION\" ]; then
                    man \"$SECTION\" \"\$cmd\" 2>/dev/null | bat -l man -p --paging=never || man -P cat \"$SECTION\" \"\$cmd\"
                else
                    man \"\$sec\" \"\$cmd\" 2>/dev/null | bat -l man -p --paging=never || man -P cat \"\$cmd\"
                fi
            else
                if [ -n \"$SECTION\" ]; then
                    man \"$SECTION\" \"\$cmd\" 2>/dev/null | head -$fzf_preview_lines || man -P cat \"$SECTION\" \"\$cmd\"
                else
                    man \"\$sec\" \"\$cmd\" 2>/dev/null | head -$fzf_preview_lines || man -P cat \"\$cmd\"
                fi
            fi
        fi
    ")

manual_cmd=$(echo "$manual_line" | sed 's/\\x1b\\[[0-9;]*m//g' | awk '{print $2}')
manual_sec=$(echo "$manual_line" | sed 's/\\x1b\\[[0-9;]*m//g' | awk '{gsub(/[()]/,"",$1); print $1}')

# auto-section for headers
case "$manual_cmd" in
    *.h) manual_sec=7 ;;
esac

case "$manual_cmd" in
    ""|"0"*"quit") exit 0 ;;
    *)
        if [ -n "$SECTION" ]; then
            man "$SECTION" "$manual_cmd" 2>/dev/null || man -P cat "$SECTION" "$manual_cmd"
        else
            man "$manual_sec" "$manual_cmd" 2>/dev/null || man -P cat "$manual_cmd"
        fi
        ;;
esac
